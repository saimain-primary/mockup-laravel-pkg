{
    "name": "saimain/laravel-mock-api",
    "description": "File-backed mock API responses with a zero-config management panel, for frontend development before the real backend exists.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/validation": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Saimain\\LaravelMockApi\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Saimain\\LaravelMockApi\\MockApiServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
